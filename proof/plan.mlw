(** # The plan of a stub

A model of the stubs generated by camlid, and `schedule`, which is proved
to give plans that are safe in this model. `schedule` is extracted to
`lib/plan_gen.ml`, the printer (`Expert.code_c_fun_of_plan`) translates
each step into C.

The model is abstract: the C templates of the types are trusted to match
their contract (`param`). It checks the order of the steps:

- P1: each C value owned by the stub is freed or moved exactly once, on
  every path;
- P2: the C function and the conversions only use initialized C values;
- P3: a `value` used after an allocation is registered with the GC, and a
  `noalloc` stub neither allocates nor raises;
- P4: the OCaml heap is not used while the runtime lock is released;
- P5: a C value owned by OCaml is moved into at most one OCaml value;
- P6: nothing owned by the stub is alive when an exception is raised.

The parameters are numbered by their position in the list.

Trusted, not proved:

- each C template matches its contract: the effects of the conversions,
  the destructor accepts the initial value, a check doesn't allocate;
- the C function produces nothing when `~error` says it failed, and
  doesn't call the OCaml runtime (unless `~noalloc:false`);
- the printer translates each step faithfully (golden tests in `tests/`);
- the extraction maps `int` to the OCaml `int` (`camlid.drv`): the
  integers are positions in the list of parameters;
- the bytecode stub and the OCaml `external` are out of the model. *)

module Types

  use int.Int
  use list.List
  use list.Mem
  use list.Length
  use list.NthNoOpt
  use list.Distinct
  use option.Option

  (** ## The description of the parameters *)

  (** The effects of a conversion on the OCaml runtime: `alloc` when it
      allocates in the OCaml heap or registers values with `CAMLparam`,
      `raising` when it can raise an OCaml exception, before acquiring any
      resource. *)
  type effects = { alloc : bool; raising : bool }

  let predicate is_pure (e: effects) = not e.alloc && not e.raising

  type input_kind = No_input | Boxed_input | Unboxed_input
  type output_kind = No_output | Boxed_output | Unboxable_output

  type param = {
    input : input_kind;
    output : output_kind;
    owned_by_ml : bool;
      (** the C value is stored in an OCaml block: the input is borrowed,
          the output is moved into a new block *)
    init : bool;  (** has a constructor (used when it is not an input) *)
    free : bool;  (** has a destructor, which accepts the zero value *)
    value_locals : bool;  (** has C locals of type `value` *)
    ml_heap : bool;  (** its C argument points into the OCaml heap *)
    ml2c : effects;  (** the conversion of its input *)
    c2ml : effects;  (** the boxed conversion of its output *)
    in_check : bool;  (** its input is checked before any conversion *)
    out_check : bool;  (** its output is checked after the call *)
  }

  type options = {
    want_noalloc : option bool;  (** `None`: when possible *)
    release_lock : bool;
    error : bool;  (** the result of the C function is checked *)
  }

  (** ## Plans *)

  type result_kind =
    | Unit_result
    | One_value int  (** a boxed result *)
    | One_unboxed int  (** an unboxed result, returned as a C value *)
    | Tuple (list int)  (** the outputs, stored in a tuple *)

  type gc_roots = {
    inputs : list int;  (** boxed inputs, `CAMLparam` *)
    outputs : list int;  (** boxed outputs, `CAMLlocal` *)
    ret : bool;  (** the tuple *)
    err : bool;  (** the message of the exception *)
    c_values : list int;  (** parameters with C locals of type `value` *)
  }

  (** What to do before raising: move the outputs owned by OCaml into
      OCaml values (their finalizers will clear them), then free. *)
  type cleanup = { moves : list int; frees : list int }

  type step =
    | Check_in (list int)  (** check the inputs, raise on failure *)
    | Ml2c (list int)
    | Init (list int)
    | Call (list int) bool  (** the arguments; releases the lock *)
    | Check_error cleanup  (** the C function failed: cleanup, raise *)
    | Check_out (list int) cleanup  (** check the outputs *)
    | C2ml (list int)
    | Alloc_tuple (list int)
    | Free (list int)
    | Return

  type plan = {
    noalloc : bool;  (** no roots, `[@@noalloc]` *)
    result : result_kind;
    roots : gc_roots;
    steps : list step;
  }


  type sched_error =
    | Bad_call  (** an argument of the call is not a parameter *)
    | Input_output_owned
        (** an input and output owned by OCaml: two OCaml values *)
    | Owned_unused  (** owned by OCaml, but neither an input nor an output *)
    | Raising_owning_input
        (** the conversion of an input with a destructor raising: use a
            check *)
    | Raising_output  (** the conversion of an output raising: use a check *)
    | Lock_ml_heap
        (** the lock can't be released, an argument points into the OCaml
            heap *)
    | Not_noalloc  (** noalloc was requested but is not possible *)

  type schedule_result = Ok plan | Error sched_error

  (** Selection of the parameters *)
  type sel =
    | S_boxed_input | S_input | S_output | S_init | S_free | S_value_locals
    | S_in_check | S_out_check | S_raising_input | S_quiet_input
    | S_move_error | S_move_out
    | S_input_output_owned | S_owned_unused
    | S_raising_owning_input | S_raising_output | S_not_noalloc

  let predicate has_input (q: param) =
    match q.input with No_input -> false | _ -> true end
  let predicate boxed_input (q: param) =
    match q.input with Boxed_input -> true | _ -> false end
  let predicate has_output (q: param) =
    match q.output with No_output -> false | _ -> true end
  let predicate unboxable_output (q: param) =
    match q.output with Unboxable_output -> true | _ -> false end

  let predicate selected (x: sel) (q: param) =
    match x with
    | S_boxed_input -> boxed_input q
    | S_input -> has_input q
    | S_output -> has_output q
    | S_init -> not has_input q && q.init
    | S_free -> q.free
    | S_value_locals -> q.value_locals
    | S_in_check -> has_input q && q.in_check
    | S_out_check -> has_output q && q.out_check
    | S_raising_input -> has_input q && q.ml2c.raising
    | S_quiet_input -> has_input q && not q.ml2c.raising
    | S_move_error ->
      has_output q && q.owned_by_ml && not has_input q && q.init
    | S_move_out -> has_output q && q.owned_by_ml
    | S_input_output_owned ->
      has_input q && has_output q && q.owned_by_ml
    | S_owned_unused ->
      not has_input q && not has_output q && q.owned_by_ml
    | S_raising_owning_input ->
      has_input q && q.ml2c.raising && q.free
    | S_raising_output -> has_output q && q.c2ml.raising
    | S_not_noalloc ->
      not (is_pure q.ml2c) || q.in_check || q.out_check
    end

  predicate valid_idx (ps: list param) (l: list int) =
    forall i. mem i l -> 0 <= i < length ps

  function prm (ps: list param) (i: int) : param = nth i ps

end

(** ## Lists of parameters *)

module Lists

  use int.Int
  use list.List
  use list.Mem
  use list.Length
  use list.NthNoOpt
  use list.Distinct
  use option.Option
  use Types

  (** The positions `i` of the parameters selected by `x` (shifted by
      `n`) *)
  let rec function pids (x: sel) (ps: list param) (n: int) : list int
    variant { ps }
    ensures { forall i. mem i result <->
                n <= i < n + length ps /\ selected x (nth (i - n) ps) }
    ensures { distinct result }
    ensures { forall i. mem i result -> n <= i }
  = match ps with
    | Nil -> Nil
    | Cons q r ->
      let l = pids x r (n + 1) in
      assert { forall i. n < i -> nth (i - n) ps = nth (i - (n + 1)) r };
      assert { nth (n - n) ps = q };
      if selected x q then Cons n l else l
    end

  let rec exists_sel (x: sel) (ps: list param) : bool
    variant { ps }
    ensures { result <->
                exists i. 0 <= i < length ps /\ selected x (nth i ps) }
  = match ps with
    | Nil -> false
    | Cons q r ->
      let b = exists_sel x r in
      assert { forall j. 0 <= j -> nth (j + 1) ps = nth j r };
      assert { nth 0 ps = q };
      selected x q || b
    end

  let rec function get (ps: list param) (i: int) : param
    requires { 0 <= i < length ps }
    variant { ps }
    ensures { result = nth i ps }
  = match ps with
    | Nil -> absurd
    | Cons q r -> if i = 0 then q else get r (i - 1)
    end

  let rec valid_call (n: int) (l: list int) : bool
    variant { l }
    ensures { result <-> forall i. mem i l -> 0 <= i < n }
  = match l with
    | Nil -> true
    | Cons i r -> 0 <= i && i < n && valid_call n r
    end

  let rec heap_in_call (ps: list param) (l: list int) : bool
    requires { valid_idx ps l }
    variant { l }
    ensures { result <-> exists i. mem i l /\
                ((nth i ps).ml_heap \/ (nth i ps).value_locals) }
  = match l with
    | Nil -> false
    | Cons i r ->
      let q = get ps i in
      q.ml_heap || q.value_locals || heap_in_call ps r
    end

end

module Model

  use int.Int
  use list.List
  use list.Mem
  use list.Length
  use list.NthNoOpt
  use list.Distinct
  use option.Option
  use Types

  (** ## The model *)

  type cstate =
    | Zero  (** the initial value, accepted by the destructor *)
    | Owned  (** must be freed or moved *)
    | Borrowed  (** must not be freed *)
    | Moved  (** moved into an OCaml value *)
    | Freed

  type state = {
    st : int -> cstate;
    vin : int -> bool;  (** the boxed input is a valid value *)
    vout : int -> bool;  (** the output has been converted, and is valid *)
    mv : int -> bool;  (** the C value has been moved into an OCaml value *)
    vc : int -> bool;  (** the C locals of type `value` are valid *)
    vret : bool;
    lock : bool;  (** the runtime lock is held *)
    called : bool;
    unlocked_call : bool;
    checked_error : bool;
  }

  constant init_state : state = {
    st = (fun _ -> Zero);
    vin = (fun _ -> true);
    vout = (fun _ -> false);
    mv = (fun _ -> false);
    vc = (fun _ -> true);
    vret = false;
    lock = true;
    called = false;
    unlocked_call = false;
    checked_error = false;
  }

  (** After an allocation, only the registered values are valid *)
  function gc (p: plan) (s: state) : state = {
    s with
    vin = (fun i -> s.vin i && mem i p.roots.inputs);
    vout = (fun i -> s.vout i && mem i p.roots.outputs);
    vc = (fun i -> s.vc i && mem i p.roots.c_values);
    vret = s.vret && p.roots.ret;
  }

  predicate no_owned (ps: list param) (s: state) =
    forall i. 0 <= i < length ps -> s.st i <> Owned

  predicate any_alloc_in (ps: list param) (l: list int) =
    exists i. mem i l /\ (prm ps i).ml2c.alloc

  predicate any_raises_in (ps: list param) (l: list int) =
    exists i. mem i l /\ (prm ps i).ml2c.raising

  (** The effects of the conversion of the output `i`: an unboxed result
      is returned as a C value *)
  constant pure_eff : effects = { alloc = false; raising = false }

  function c2ml_eff (ps: list param) (p: plan) (i: int) : effects =
    if p.result = One_unboxed i then pure_eff
    else (prm ps i).c2ml

  predicate any_alloc_out (ps: list param) (p: plan) (l: list int) =
    exists i. mem i l /\ (c2ml_eff ps p i).alloc

  (** Produced by the C function: not an input, no constructor *)
  predicate produced (q: param) = q.input = No_input /\ not q.init

  function acquired (q: param) : cstate =
    if q.free || q.owned_by_ml then Owned else Borrowed

  (** The C function failed: it produced nothing *)
  function revert (ps: list param) (s: state) : state =
    { s with st = (fun i -> if produced (prm ps i) then Zero else s.st i) }

  (** The cleanup before raising is safe in state `s`, where the message
      has been allocated *)
  predicate cleanup_ok (ps: list param) (p: plan) (s: state) (c: cleanup) =
    valid_idx ps c.moves /\ valid_idx ps c.frees /\
    distinct c.moves /\ distinct c.frees /\
    p.roots.err /\
    (forall i. mem i c.moves ->
       (prm ps i).output <> No_output /\ (prm ps i).owned_by_ml /\
       (prm ps i).input = No_input /\ s.st i = Owned /\ not s.mv i) /\
    (forall i. mem i c.frees ->
       (prm ps i).free /\ (s.st i = Owned \/ s.st i = Zero)) /\
    (forall i. 0 <= i < length ps -> s.st i = Owned ->
       mem i c.frees \/ (mem i c.moves /\ not (prm ps i).free))

  predicate result_valid (p: plan) (s: state) =
    match p.result with
    | Unit_result -> true
    | One_value i | One_unboxed i -> s.vout i
    | Tuple _ -> s.vret
    end

  predicate inputs_converted (ps: list param) (s: state) =
    forall j. 0 <= j < length ps -> (prm ps j).input <> No_input ->
      s.st j <> Zero

  (** The precondition of a step *)
  predicate ok_step (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state) (x: step) =
    match x with
    | Check_in l ->
      s.lock /\ valid_idx ps l /\
      (forall i. mem i l ->
         (prm ps i).input <> No_input /\
         ((prm ps i).input = Boxed_input -> s.vin i)) /\
      (l <> Nil -> no_owned ps s)
    | Ml2c l ->
      s.lock /\ valid_idx ps l /\ distinct l /\
      (forall i. mem i l ->
         (prm ps i).input <> No_input /\ s.st i = Zero /\
         ((prm ps i).input = Boxed_input -> s.vin i)) /\
      (any_alloc_in ps l -> forall i. mem i l ->
         (prm ps i).input = Boxed_input -> mem i p.roots.inputs) /\
      (any_raises_in ps l ->
         no_owned ps s /\ forall i. mem i l -> not (prm ps i).free)
    | Init l ->
      s.lock /\ valid_idx ps l /\ distinct l /\ inputs_converted ps s /\
      (forall i. mem i l -> (prm ps i).input = No_input /\ s.st i = Zero)
    | Call l release ->
      s.lock /\ not s.called /\ l = call /\ release = o.release_lock /\
      valid_idx ps l /\ inputs_converted ps s /\
      (forall i. mem i l ->
         s.st i <> Moved /\ s.st i <> Freed /\
         ((prm ps i).value_locals -> s.vc i) /\
         (release -> not (prm ps i).ml_heap /\ not (prm ps i).value_locals))
    | Check_error c ->
      s.lock /\ s.called /\ o.error /\ not s.checked_error /\
      cleanup_ok ps p (gc p (revert ps s)) c
    | Check_out l c ->
      s.lock /\ s.called /\ valid_idx ps l /\
      (forall i. mem i l ->
         (prm ps i).output <> No_output /\
         (s.st i = Owned \/ s.st i = Borrowed) /\
         ((prm ps i).value_locals -> s.vc i)) /\
      (l <> Nil -> cleanup_ok ps p (gc p s) c)
    | C2ml l ->
      s.lock /\ s.called /\ (o.error -> s.checked_error) /\
      valid_idx ps l /\ distinct l /\
      (forall i. mem i l ->
         (prm ps i).output <> No_output /\
         (s.st i = Owned \/ s.st i = Borrowed) /\
         ((prm ps i).owned_by_ml ->
            (prm ps i).input = No_input /\ s.st i = Owned /\ not s.mv i) /\
         ((prm ps i).value_locals -> s.vc i) /\
         not (c2ml_eff ps p i).raising) /\
      (any_alloc_out ps p l -> forall i. mem i l -> mem i p.roots.outputs)
    | Alloc_tuple l ->
      s.lock /\ p.roots.ret /\
      (forall i. mem i l -> mem i p.roots.outputs /\ s.vout i)
    | Free l ->
      s.called /\ valid_idx ps l /\ distinct l /\
      (forall i. mem i l ->
         (prm ps i).free /\ (s.st i = Owned \/ s.st i = Zero))
    | Return ->
      s.lock /\ s.called /\ no_owned ps s /\ result_valid p s /\
      (o.release_lock -> s.unlocked_call) /\
      (o.error -> s.checked_error) /\
      (forall i. 0 <= i < length ps -> (prm ps i).output <> No_output ->
         s.vout i \/ s.st i = Moved)
    end

  (** The state after a step that didn't raise *)
  function next (ps: list param) (p: plan) (s: state) (x: step) : state =
    match x with
    | Check_in _ | Check_error _ | Check_out _ _ | Return ->
      match x with
      | Check_error _ -> { s with checked_error = true }
      | _ -> s
      end
    | Ml2c l ->
      let s1 = { s with st = (fun i ->
        if mem i l then (if (prm ps i).free then Owned else Borrowed)
        else s.st i) } in
      if any_alloc_in ps l then gc p s1 else s1
    | Init l ->
      { s with st = (fun i ->
        if mem i l then acquired (prm ps i) else s.st i) }
    | Call _ release ->
      let s1 = { s with
        st = (fun i -> if produced (prm ps i) then acquired (prm ps i)
                       else s.st i);
        called = true; unlocked_call = release } in
      if release then gc p s1 else s1
    | C2ml l ->
      let s1 = { s with
        st = (fun i -> if mem i l && (prm ps i).owned_by_ml &&
                          not (prm ps i).free then Moved
                       else s.st i);
        mv = (fun i -> s.mv i || (mem i l && (prm ps i).owned_by_ml));
        vout = (fun i -> s.vout i || mem i l) } in
      if any_alloc_out ps p l then gc p s1 else s1
    | Alloc_tuple _ -> let s1 = gc p s in { s1 with vret = true }
    | Free l -> { s with st = (fun i -> if mem i l then Freed else s.st i) }
    end

  predicate step_noalloc (ps: list param) (p: plan) (x: step) =
    match x with
    | Check_in l | Check_out l _ -> l = Nil
    | Ml2c l -> forall i. mem i l -> is_pure (prm ps i).ml2c
    | Call _ release -> not release
    | Check_error _ | Alloc_tuple _ -> false
    | C2ml l -> forall i. mem i l -> is_pure (c2ml_eff ps p i)
    | Init _ | Free _ | Return -> true
    end

  (** The steps run safely from state `s` and end with `Return` *)
  predicate run (ps: list param) (o: options) (call: list int) (p: plan)
      (s: state) (l: list step) =
    match l with
    | Nil -> false
    | Cons x r ->
      ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
      (if x = Return then r = Nil else run ps o call p (next ps p s x) r)
    end

  constant no_roots : gc_roots =
    { inputs = Nil; outputs = Nil; ret = false; err = false; c_values = Nil }

  predicate safe (ps: list param) (o: options) (call: list int) (p: plan) =
    (p.noalloc -> p.roots = no_roots) /\
    (o.want_noalloc = Some true -> p.noalloc) /\
    (o.want_noalloc = Some false -> not p.noalloc) /\
    run ps o call p init_state p.steps

end

(** ## Proof of the steps of `schedule`

Each lemma proves one step of the plan built by `schedule`, from a
description of the state before it. *)

module Proof

  use int.Int
  use list.List
  use list.Mem
  use list.Length
  use list.NthNoOpt
  use list.Distinct
  use option.Option
  use Types
  use Lists
  use Model

  predicate no_sel (x: sel) (ps: list param) =
    forall i. 0 <= i < length ps -> not selected x (nth i ps)

  function out_roots (r: result_kind) : list int =
    match r with
    | Unit_result | One_unboxed _ -> Nil
    | One_value i -> Cons i Nil
    | Tuple l -> l
    end

  function std_roots (ps: list param) (o: options) (r: result_kind) : gc_roots = {
    inputs = pids S_boxed_input ps 0;
    outputs = out_roots r;
    ret = (match r with Tuple _ -> true | _ -> false end);
    err = (o.error || match pids S_out_check ps 0 with Nil -> false | _ -> true end);
    c_values = pids S_value_locals ps 0;
  }

  predicate result_ok (ps: list param) (r: result_kind) =
    match pids S_output ps 0 with
    | Nil -> r = Unit_result
    | Cons i Nil ->
      r = (if unboxable_output (nth i ps) then One_unboxed i else One_value i)
    | l -> r = Tuple l
    end

  (** What `schedule` checked and built *)
  predicate hyp (ps: list param) (o: options) (call: list int) (p: plan) =
    valid_idx ps call /\
    no_sel S_input_output_owned ps /\ no_sel S_owned_unused ps /\
    no_sel S_raising_owning_input ps /\
    no_sel S_raising_output ps /\
    (o.release_lock -> forall i. mem i call ->
       not (nth i ps).ml_heap /\ not (nth i ps).value_locals) /\
    (p.noalloc ->
       not o.release_lock /\ not o.error /\ no_sel S_not_noalloc ps /\
       match pids S_output ps 0 with
       | Nil -> true
       | Cons i Nil ->
         is_pure (nth i ps).c2ml \/ unboxable_output (nth i ps)
       | _ -> false
       end) /\
    p.roots = (if p.noalloc then no_roots else std_roots ps o p.result) /\
    result_ok ps p.result

  (** The values that the stub reads are valid *)
  predicate vals_ok (ps: list param) (s: state) =
    (forall i. 0 <= i < length ps -> (nth i ps).input = Boxed_input ->
       s.vin i) /\
    (forall i. 0 <= i < length ps -> (nth i ps).value_locals -> s.vc i)

  predicate outs_ok (ps: list param) (s: state) =
    forall i. 0 <= i < length ps -> has_output (nth i ps) -> s.vout i

  predicate st_is (ps: list param) (s: state) (f: param -> cstate) =
    forall i. 0 <= i < length ps -> s.st i = f (nth i ps)

  function acq_in (q: param) : cstate = if q.free then Owned else Borrowed

  function st0 (_q: param) : cstate = Zero
  function st2 (q: param) : cstate =
    if selected S_raising_input q then acq_in q else Zero
  function st3 (q: param) : cstate =
    if has_input q then acq_in q else Zero
  function st4 (q: param) : cstate =
    if has_input q then acq_in q else if q.init then acquired q else Zero
  function st5 (q: param) : cstate =
    if has_input q then acq_in q else acquired q
  function st8 (q: param) : cstate =
    if has_output q && q.owned_by_ml && not q.free then Moved else st5 q
  function st10 (q: param) : cstate =
    if q.free then Freed else st8 q

  predicate no_mv (s: state) = forall i. not s.mv i

  (** Before the call *)
  predicate before (ps: list param) (s: state) (f: param -> cstate) =
    st_is ps s f /\ vals_ok ps s /\ s.lock /\ not s.called /\
    not s.checked_error /\ no_mv s

  (** After the call *)
  predicate after (ps: list param) (o: options) (s: state)
      (f: param -> cstate) =
    st_is ps s f /\ vals_ok ps s /\ s.lock /\ s.called /\
    s.unlocked_call = o.release_lock

  let ghost gc_ok (ps: list param) (o: options) (call: list int) (p: plan)
      (s: state)
    requires { hyp ps o call p }
    requires { not p.noalloc }
    requires { vals_ok ps s }
    ensures { vals_ok ps (gc p s) }
  = ()

  let ghost l_check_in (ps: list param) (o: options) (call: list int)
      (p: plan)
    requires { hyp ps o call p }
    ensures { let x = Check_in (pids S_in_check ps 0) in
              ok_step ps o call p init_state x /\
              (p.noalloc -> step_noalloc ps p x) /\
              next ps p init_state x = init_state }
    ensures { before ps init_state st0 }
  = ()

  let ghost l_ml2c_r (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state)
    requires { hyp ps o call p }
    requires { before ps s st0 }
    ensures { let x = Ml2c (pids S_raising_input ps 0) in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              before ps (next ps p s x) st2 }
  = ()

  let ghost l_ml2c_q (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state)
    requires { hyp ps o call p }
    requires { before ps s st2 }
    ensures { let x = Ml2c (pids S_quiet_input ps 0) in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              before ps (next ps p s x) st3 }
  = ()

  let ghost l_init (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state)
    requires { hyp ps o call p }
    requires { before ps s st3 }
    ensures { let x = Init (pids S_init ps 0) in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              before ps (next ps p s x) st4 }
  = ()

  let ghost l_call (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state)
    requires { hyp ps o call p }
    requires { before ps s st4 }
    ensures { let x = Call call o.release_lock in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              after ps o (next ps p s x) st5 /\ no_mv (next ps p s x) /\
              not (next ps p s x).checked_error }
  = ()

  let ghost l_check_error (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state)
    requires { hyp ps o call p }
    requires { o.error }
    requires { after ps o s st5 /\ no_mv s /\ not s.checked_error }
    ensures { let x = Check_error { moves = pids S_move_error ps 0;
                                    frees = pids S_free ps 0 } in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              after ps o (next ps p s x) st5 /\ no_mv (next ps p s x) /\
              (next ps p s x).checked_error }
  = ()

  let ghost l_check_out (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state)
    requires { hyp ps o call p }
    requires { after ps o s st5 /\ no_mv s /\ (o.error -> s.checked_error) }
    ensures { let x = Check_out (pids S_out_check ps 0)
                        { moves = pids S_move_out ps 0;
                          frees = pids S_free ps 0 } in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              next ps p s x = s }
  = match pids S_out_check ps 0 with
    | Nil -> ()
    | Cons i _ ->
      assert { selected S_out_check (nth i ps) };
      assert { not p.noalloc };
      assert { p.roots.err }
    end

  let ghost l_c2ml (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state)
    requires { hyp ps o call p }
    requires { after ps o s st5 /\ no_mv s /\ (o.error -> s.checked_error) }
    ensures { let x = C2ml (pids S_output ps 0) in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              after ps o (next ps p s x) st8 /\
              outs_ok ps (next ps p s x) /\
              (o.error -> (next ps p s x).checked_error) }
  = let l = pids S_output ps 0 in
    let ghost s1 = { s with
      st = (fun i -> if mem i l && (prm ps i).owned_by_ml &&
                        not (prm ps i).free then Moved
                     else s.st i);
      mv = (fun i -> s.mv i || (mem i l && (prm ps i).owned_by_ml));
      vout = (fun i -> s.vout i || mem i l) } in
    assert { vals_ok ps s1 };
    if not p.noalloc then begin
      gc_ok ps o call p s1;
      assert { p.roots.outputs = out_roots p.result }
    end;
    match l with
    | Nil -> assert { p.result = Unit_result }
    | Cons i Nil ->
      assert { p.result = One_value i \/ p.result = One_unboxed i };
      assert { p.result = One_unboxed i -> c2ml_eff ps p i = Model.pure_eff };
      assert { not any_alloc_out ps p l \/ p.result = One_value i }
    | _ ->
      assert { p.result = Tuple l };
      assert { not p.noalloc };
      assert { p.roots.outputs = l }
    end

  let ghost l_tuple (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state) (l: list int)
    requires { hyp ps o call p }
    requires { p.result = Tuple l }
    requires { after ps o s st8 /\ outs_ok ps s /\
               (o.error -> s.checked_error) }
    ensures { let x = Alloc_tuple l in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              after ps o (next ps p s x) st8 /\
              outs_ok ps (next ps p s x) /\ (next ps p s x).vret /\
              (o.error -> (next ps p s x).checked_error) }
  = assert { pids S_output ps 0 = l };
    assert { match l with Nil | Cons _ Nil -> false | _ -> true end };
    assert { not p.noalloc };
    assert { p.roots.outputs = l };
    assert { forall i. mem i l -> 0 <= i < length ps /\ has_output (nth i ps) };
    gc_ok ps o call p s

  let ghost l_free (ps: list param) (o: options) (call: list int)
      (p: plan) (s: state)
    requires { hyp ps o call p }
    requires { after ps o s st8 /\ outs_ok ps s /\
               (o.error -> s.checked_error) /\
               (match p.result with Tuple _ -> s.vret | _ -> true end) }
    ensures { let x = Free (pids S_free ps 0) in
              ok_step ps o call p s x /\ (p.noalloc -> step_noalloc ps p x) /\
              ok_step ps o call p (next ps p s x) Return /\
              (p.noalloc -> step_noalloc ps p Return) }
  = match p.result with
    | One_value i | One_unboxed i ->
      assert { pids S_output ps 0 = Cons i Nil };
      assert { mem i (pids S_output ps 0) };
      assert { 0 <= i < length ps /\ has_output (nth i ps) }
    | _ -> ()
    end

end

module Schedule

  use Proof
  use int.Int
  use list.List
  use list.Mem
  use list.Length
  use list.NthNoOpt
  use list.Distinct
  use option.Option
  use Types
  use Lists
  use Model

  predicate has_sel (x: sel) (ps: list param) =
    exists i. 0 <= i < length ps /\ selected x (nth i ps)

  (** The noalloc stub is possible *)
  predicate can_noalloc (ps: list param) (o: options) (outputs: list int) =
    not o.release_lock /\ not o.error /\
    not has_sel S_not_noalloc ps /\
    match outputs with
    | Nil -> true
    | Cons i Nil ->
      is_pure (nth i ps).c2ml \/ (nth i ps).output = Unboxable_output
    | _ -> false
    end

  (** The conditions of the errors *)
  predicate error_cond (ps: list param) (o: options) (call: list int)
      (e: sched_error) =
    match e with
    | Bad_call -> not valid_idx ps call
    | Input_output_owned -> has_sel S_input_output_owned ps
    | Owned_unused -> has_sel S_owned_unused ps
    | Raising_owning_input -> has_sel S_raising_owning_input ps
    | Raising_output -> has_sel S_raising_output ps
    | Lock_ml_heap ->
      o.release_lock /\ exists i. mem i call /\
        ((nth i ps).ml_heap \/ (nth i ps).value_locals)
    | Not_noalloc ->
      o.want_noalloc = Some true /\
      not can_noalloc ps o (pids S_output ps 0)
    end

  let schedule (o: options) (ps: list param) (call: list int)
    : schedule_result
    ensures { match result with
              | Ok p -> safe ps o call p
              | Error e -> error_cond ps o call e
              end }
    ensures { (forall e. not error_cond ps o call e) ->
                exists p. result = Ok p }
  = if not valid_call (length ps) call then Error Bad_call
    else if exists_sel S_input_output_owned ps then Error Input_output_owned
    else if exists_sel S_owned_unused ps then Error Owned_unused
    else if exists_sel S_raising_owning_input ps then
      Error Raising_owning_input
    else if exists_sel S_raising_output ps then Error Raising_output
    else if o.release_lock && heap_in_call ps call then Error Lock_ml_heap
    else
      let outputs = pids S_output ps 0 in
      let can_noalloc =
        not o.release_lock && not o.error &&
        not exists_sel S_not_noalloc ps &&
        match outputs with
        | Nil -> true
        | Cons i Nil ->
          let q = get ps i in
          is_pure q.c2ml || unboxable_output q
        | _ -> false
        end
      in
      let noalloc =
        match o.want_noalloc with
        | None -> can_noalloc
        | Some b -> b
        end
      in
      if noalloc && not can_noalloc then Error Not_noalloc
      else
        let result =
          match outputs with
          | Nil -> Unit_result
          | Cons i Nil ->
            if unboxable_output (get ps i) then One_unboxed i
            else One_value i
          | l -> Tuple l
          end
        in
        let out_checks = pids S_out_check ps 0 in
        let roots =
          if noalloc then
            { inputs = Nil; outputs = Nil; ret = false; err = false;
              c_values = Nil }
          else
            { inputs = pids S_boxed_input ps 0;
              outputs =
                (match result with
                 | Unit_result | One_unboxed _ -> Nil
                 | One_value i -> Cons i Nil
                 | Tuple l -> l
                 end);
              ret = (match result with Tuple _ -> true | _ -> false end);
              err = o.error || (match out_checks with Nil -> false | _ -> true end);
              c_values = pids S_value_locals ps 0 }
        in
        let cin = pids S_in_check ps 0 in
        let rin = pids S_raising_input ps 0 in
        let qin = pids S_quiet_input ps 0 in
        let ini = pids S_init ps 0 in
        let frees = pids S_free ps 0 in
        let cerr = { moves = pids S_move_error ps 0; frees = frees } in
        let cout = { moves = pids S_move_out ps 0; frees = frees } in
        let t_free = Cons (Free frees) (Cons Return Nil) in
        let t_tuple =
          match result with
          | Tuple l -> Cons (Alloc_tuple l) t_free
          | _ -> t_free
          end
        in
        let t_c2ml = Cons (C2ml outputs) t_tuple in
        let t_out = Cons (Check_out out_checks cout) t_c2ml in
        let t_err =
          if o.error then Cons (Check_error cerr) t_out else t_out in
        let t_call = Cons (Call call o.release_lock) t_err in
        let t_init = Cons (Init ini) t_call in
        let t_qin = Cons (Ml2c qin) t_init in
        let t_rin = Cons (Ml2c rin) t_qin in
        let steps = Cons (Check_in cin) t_rin in
        let p = { noalloc = noalloc; result = result; roots = roots;
                  steps = steps } in
        (* proof *)
        assert { result_ok ps result };
        assert { roots = (if noalloc then no_roots else std_roots ps o result) };
        assert { noalloc -> can_noalloc };
        assert { hyp ps o call p };
        let ghost s0 = init_state in
        l_check_in ps o call p;
        l_ml2c_r ps o call p s0;
        let ghost s2 = next ps p s0 (Ml2c rin) in
        l_ml2c_q ps o call p s2;
        let ghost s3 = next ps p s2 (Ml2c qin) in
        l_init ps o call p s3;
        let ghost s4 = next ps p s3 (Init ini) in
        l_call ps o call p s4;
        let ghost s5 = next ps p s4 (Call call o.release_lock) in
        let ghost s6 =
          if o.error then begin
            l_check_error ps o call p s5;
            next ps p s5 (Check_error cerr) end
          else s5 in
        l_check_out ps o call p s6;
        l_c2ml ps o call p s6;
        let ghost s8 = next ps p s6 (C2ml outputs) in
        let ghost s9 =
          match result with
          | Tuple l -> l_tuple ps o call p s8 l; next ps p s8 (Alloc_tuple l)
          | _ -> s8
          end
        in
        l_free ps o call p s9;
        let ghost s10 = next ps p s9 (Free frees) in
        assert { run ps o call p s10 (Cons Return Nil) };
        assert { run ps o call p s9 t_free };
        assert { run ps o call p s8 t_tuple };
        assert { run ps o call p s6 t_c2ml };
        assert { run ps o call p s6 t_out };
        assert { run ps o call p s5 t_err };
        assert { run ps o call p s4 t_call };
        assert { run ps o call p s3 t_init };
        assert { run ps o call p s2 t_qin };
        assert { run ps o call p s0 t_rin };
        assert { run ps o call p s0 steps };
        Ok p
end
